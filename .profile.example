# Copy this file to ".profile" and edit it. ClassForge reads it on startup.
# Lines here override any environment variables already set on your machine.

# ---- Notes/quiz engine (pick ONE path) ----
# 1) Local, free, offline (default if Ollama is installed):
# OLLAMA_EXE=C:\Users\you\AppData\Local\Programs\Ollama\ollama.exe
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELS=D:\ollama-models

# 2) Google Gemini:
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash-lite

# 3) Anthropic Claude:
# ANTHROPIC_API_KEY=your-key-here
# CLAUDE_MODEL=claude-opus-5-5

# Force a specific engine regardless of what's configured above:
# AI_PROVIDER=ollama      # ollama | gemini | claude | none

# ---- Transcription ----
# WHISPER_MODEL=small      # tiny | base | small | medium | large-v3

# ---- Chaptering ----
# CLASSFORGE_MIN_CHAPTER_GAP=180   # seconds; smallest allowed gap between chapters

# ---- Storage ----
# CLASSFORGE_DATA_DIR=D:\classforge-data

# ---- Network ----
# CLASSFORGE_ALLOWED_HOSTS=my-laptop.local
